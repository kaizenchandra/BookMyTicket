# Local-only PostgreSQL started by npm run db:local. Not a production credential.
DATABASE_URL=postgresql://bookmyticket:local-only-change-me@127.0.0.1:55432/bookmyticket_dev
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Explicit local SMTP capture. Use OTP_DELIVERY=resend plus a verified sender for real delivery.
OTP_DELIVERY=mailpit
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_URL=http://127.0.0.1:8025
RESEND_API_KEY=
OTP_FROM=BookMyTicket <no-reply@bookmyticket.test>
OTP_PEPPER=
# Live-only integration: provider test-mode exception has not been authorized.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
# 32-byte AES key, hex encoded; inject from your secret manager.
TICKET_ENCRYPTION_KEY=

# Dedicated 32-byte AES key (hex) for authenticator secrets, separate from ticket encryption.
MFA_ENCRYPTION_KEY=

# 32 random bytes as 64 hex characters; keep stable and back up securely.
# Also derives a separate key for optional saved attendee shortcuts.
REGISTRATION_ENCRYPTION_KEY=

# Dedicated 32-byte hexadecimal key for expiring attendee export artifacts.
EXPORT_ENCRYPTION_KEY=
