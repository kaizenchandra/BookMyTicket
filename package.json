{
  "name": "bookmyticket",
  "version": "0.107.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "db:local": "node --import tsx scripts/local-db.ts",
    "format": "prettier --write src web scripts tests vite.config.ts",
    "contracts": "node --import tsx scripts/generate-contracts.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "ical.js": "2.2.1",
    "jsqr": "1.4.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
